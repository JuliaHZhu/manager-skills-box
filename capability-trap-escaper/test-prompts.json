{
  "skill": "capability-trap-escaper",
  "tests": [
    {
      "prompt": "我们公司做了20年传统零售，电商冲击越来越大，但内部总觉得'我们以前成功过'。怎么打破这种能力陷阱？",
      "expected": "CALL",
      "type": "should_trigger"
    },
    {
      "prompt": "华为是怎么通过奇正相生避免能力陷阱的？我想学习这种红蓝转换的机制。",
      "expected": "CALL",
      "type": "should_trigger"
    },
    {
      "prompt": "感觉公司越来越僵化，新业务总被老业务的KPI同化。怎么设计一个独立的创新部门？",
      "expected": "CALL",
      "type": "should_trigger"
    },
    {
      "prompt": "我在这个行业干了15年，想转型但担心放弃积累。个人怎么避免能力陷阱？",
      "expected": "CALL",
      "type": "should_trigger"
    },
    {
      "prompt": "帮我设计一个企业蓝军部门的组织架构和运作机制。",
      "expected": "PASS_TO_BLUE_TEAM_ORGANIZER",
      "type": "cross_skill_bait",
      "notes": "应触发同书的blue-team-organizer"
