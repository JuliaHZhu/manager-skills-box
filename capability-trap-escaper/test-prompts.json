    {
      "prompt": "创业公司刚成立半年，产品还在打磨中。现在需要担心能力陷阱吗？",
      "expected": "NO_CALL",
      "type": "should_not_trigger",
      "notes": "初创期，先专注打磨PMF"
    },
    {
      "prompt": "传统胶卷行业已经被数码相机彻底替代了，现在进入还有什么办法？",
      "expected": "NO_CALL",
      "type": "should_not_trigger",
      "notes": "已被验证的衰退行业，应退出而非突破"
    },
    {
      "prompt": "公司准备上市，未来6个月需要全力冲刺业绩。这时候适合搞内部创新吗？",
      "expected": "NO_CALL",
      "type": "boundary",
      "notes": "需要极致专注的阶段"
    },
    {
      "prompt": "我想用红队策略分析方法来审视我的转型计划。",
      "expected": "PASS_TO_RED_TEAM_ANALYST",
      "type": "cross_skill_bait",
      "notes": "应触发同书的red-team-analyst"
    },
    {
      "prompt": "公司核心供应商是单一来源，需要设计备胎方案。",
      "expected": "PASS_TO_PLAN_B_STRATEGIST",
      "type": "cross_skill_bait",
      "notes": "应触发同书的plan-b-strategist"
    }
